# admin.belkamarket.ru
BELKA_LOGIN=
BELKA_PASSWORD=
BELKA_TOKEN=
# BELKA_TOKEN_REFRESH и BELKA_TOKEN_EXPIRES_AT пайплайн проставляет и
# обновляет сам (не нужно заполнять руками) — если заданы BELKA_LOGIN и
# BELKA_PASSWORD, токен логинится/обновляется автоматически: сначала через
# refresh_token (без пароля), и только если это не сработало — полным
# логином. См. belka/core/http.py::AuthTokenManager.

# console.псбмаркет.рф — нужен только stage'у 'bridge'
BELKA_CONSOLE_LOGIN=
BELKA_CONSOLE_PASSWORD=
BELKA_CONSOLE_TOKEN=

# apigw-seller.псбмаркет.рф — нужен складам mvideo/b2c (stage 'psb_generate').
# Статический Bearer-токен, без слова "Bearer" и без автообновления (ни в
# одном из присланных скриптов нет логина/refresh для этого хоста — токен
# нужно будет обновлять руками, когда протухнет).
PSB_TOKEN=

# --- необязательные переопределения рецепта склада ---------------------------
#
# ВАЖНО (09.2026): переопределения работают ТОЛЬКО с именем склада в ключе —
# BELKA_<СКЛАД>_<ПАРАМЕТР>, где <СКЛАД> это BAZAR / MVIDEO / B2C.
#
# Безымянные ключи (BELKA_STORE_ID, BELKA_SELLER_ID, BELKA_UPLOAD_DIR,
# BELKA_TEMPLATES_DIR, BELKA_PSB_SELLER_ID) больше НЕ ПРИМЕНЯЮТСЯ: .env один
# на весь проект, а значения у складов разные — оставшийся в файле
# BELKA_STORE_ID=5 молча уводил загрузку Мвидео в склад Базара. Если такой
# ключ найдётся в .env, пайплайн напечатает предупреждение и возьмёт значение
# из рецепта склада (belka/warehouses/<склад>.py).
#
# По умолчанию НИЧЕГО задавать не нужно — рецепты складов уже содержат
# правильные значения:
#   bazar  seller_id=6 store_id=5
#   mvideo seller_id=6 store_id=6  psb_seller_id=475
#   b2c    seller_id=6 store_id=7  psb_seller_id=141
#
# BELKA_BAZAR_STORE_ID=5
# BELKA_BAZAR_SELLER_ID=6
# BELKA_MVIDEO_PSB_SELLER_ID=475
# BELKA_B2C_PSB_SELLER_ID=141
#
# Папки: по умолчанию это output/<склад>/ГГГГ-ММ-ДД (см. resolved_output_dir).
# Переопределять стоит только для разбора инцидентов — заданный путь дневную
# папку НЕ получает, берётся как есть:
# BELKA_BAZAR_TEMPLATES_DIR=output/bazar/2026-09-11    # вход для import_*
# BELKA_BAZAR_UPLOAD_DIR=output/bazar/2026-09-11       # вход для upload

# наценка stage'а 'generate': к "Цена, руб *" прибавляется
# BELKA_PRICE_MARKUP_CONST * "Количество в упаковке" (на "Цена до скидки, руб"
# не влияет). 0 или не задано — наценки нет.
# BELKA_PRICE_MARKUP_CONST=0
